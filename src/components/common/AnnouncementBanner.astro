---
export interface Props {
  text: string;
  ctaText?: string;
  href?: string;
}

const { text, ctaText, href } = Astro.props;
---

<div
  id="announcement-banner"
  class="bg-primary-dark text-secondary relative py-2.5 px-10"
>
  <div class="container-nav text-center text-base leading-snug">
    {href ? (
      <a href={href} class="hover:text-white transition-colors duration-150">
        {text}{ctaText && <span class="font-bold underline underline-offset-2 ml-1">{ctaText}</span>}
      </a>
    ) : (
      <span>{text}{ctaText && <span class="font-bold underline underline-offset-2 ml-1">{ctaText}</span>}</span>
    )}
  </div>
  <button
    id="announcement-close"
    aria-label="Dismiss announcement"
    class="absolute right-3 top-1/2 -translate-y-1/2 p-1.5 opacity-60 hover:opacity-100 transition-opacity duration-150 rounded"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const banner = document.getElementById('announcement-banner');
    const closeBtn = document.getElementById('announcement-close');
    if (!banner || !closeBtn) return;
    closeBtn.addEventListener('click', () => {
      banner.style.display = 'none';
    });
  });
</script>
