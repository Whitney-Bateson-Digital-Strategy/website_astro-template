---
import { Icon } from 'astro-icon/components';

export interface FooterLink {
  text: string;
  href: string;
}

export interface FooterLinkGroup {
  title: string;
  links: FooterLink[];
}

export interface SocialLink {
  ariaLabel: string;
  icon: string;
  href: string;
}

export interface Props {
  links?: FooterLinkGroup[];
  secondaryLinks?: FooterLink[];
  socialLinks?: SocialLink[];
  footNote?: string;
}

const { links = [], secondaryLinks = [], socialLinks = [], footNote = '' } = Astro.props;
---

<footer class="bg-bg-subtle border-t border-border">
  <div class="container-page py-12 md:py-16">

    {links.length > 0 && (
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-10">
        <div class="col-span-2 md:col-span-2">
          <a href="/" aria-label="Home">
            <img
              src="/Nutrition%20Consulting%20Sample%20Logo.png"
              alt="Nutrition Consulting"
              class="h-10 w-auto mb-4"
              width="160"
              height="40"
            />
          </a>
          <p class="text-sm text-text-muted max-w-xs leading-relaxed">
            Supporting your wellness journey with personalized nutrition guidance.
          </p>
          <p class="mt-2 text-sm text-text-muted max-w-xs leading-relaxed">
            <em>Serving the Dallas–Fort Worth, TX area and offering virtual nutrition counseling in VA, NY, IL, and GA.</em>
          </p>
        </div>

        {links.map((group) => (
          <div>
            <p class="text-sm font-semibold text-text-heading uppercase tracking-wider mb-4">
              {group.title}
            </p>
            <ul class="flex flex-col gap-2.5">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-text-muted hover:text-primary-dark transition-colors duration-150"
                  >
                    {link.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}

    <div class="border-t border-border pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-1 flex-wrap justify-center sm:justify-start">
        {footNote && (
          <span class="text-sm text-text-muted" set:html={footNote} />
        )}
        {secondaryLinks.length > 0 && (
          <>
            <span class="text-text-muted mx-1 hidden sm:inline">·</span>
            {secondaryLinks.map((link, i) => (
              <>
                {i > 0 && <span class="text-text-muted mx-1">·</span>}
                <a
                  href={link.href}
                  class="text-sm text-text-muted hover:text-primary-dark transition-colors duration-150"
                >
                  {link.text}
                </a>
              </>
            ))}
          </>
        )}
      </div>

      {socialLinks.length > 0 && (
        <div class="flex items-center gap-3">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              aria-label={social.ariaLabel}
              class="text-text-muted hover:text-primary-dark transition-colors duration-150"
              {...(social.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <Icon name={social.icon} class="w-5 h-5" aria-hidden="true" />
            </a>
          ))}
        </div>
      )}
    </div>

  </div>
</footer>
