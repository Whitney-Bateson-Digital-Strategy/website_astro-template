---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import { trimSlash } from '~/utils/permalinks';

export interface NavLink {
  text: string;
  href?: string;
  links?: NavLink[];
}

export interface Props {
  links?: NavLink[];
  actions?: { text: string; href: string; variant?: string }[];
}

const { links = [], actions = [] } = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;
---

<header id="site-header" class="sticky top-0 z-50 bg-bg-card border-b border-border transition-all duration-300">
  <div class="container-nav flex items-center justify-between h-14 md:h-20 transition-all duration-300">

    <a href="/" class="flex-shrink-0" aria-label="Home">
      <img
        id="site-logo"
        src="/Nutrition%20Consulting%20Sample%20Logo.png"
        alt="Nutrition Consulting"
        class="h-9 md:h-12 w-auto transition-all duration-300"
        width="160"
        height="56"
      />
    </a>

    <nav class="hidden md:flex items-center gap-6" aria-label="Main navigation">
      {links.map((link) =>
        link.links?.length ? (
          <div class="group relative">
            <button
              class="flex items-center gap-1 text-text-base hover:text-primary-dark font-medium transition-colors duration-200 py-2 cursor-pointer"
              aria-haspopup="true"
              aria-expanded="false"
            >
              {link.text}
              <Icon name="tabler:chevron-down" class="w-4 h-4" aria-hidden="true" />
            </button>
            <div class="absolute top-full left-0 min-w-48 bg-bg-card border border-border rounded-md shadow-lg py-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 mt-1">
              {link.links.map((sub) => (
                <a
                  href={sub.href}
                  class="block px-4 py-2 text-sm text-text-base hover:text-primary-dark hover:bg-bg-subtle transition-colors duration-150"
                >
                  {sub.text}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            class={`font-medium transition-colors duration-200 ${link.href && currentPath === `/${trimSlash(link.href)}` ? 'text-primary-dark' : 'text-text-base hover:text-primary-dark-dark'}`}
          >
            {link.text}
          </a>
        )
      )}
    </nav>

    <div class="flex items-center gap-3">
      {actions.length > 0 && (
        <div class="hidden md:flex items-center gap-2">
          {actions.map((action) => (
            <Button href={action.href} variant={(action.variant as any) ?? 'primary'}>
              {action.text}
            </Button>
          ))}
        </div>
      )}

      <button
        id="menu-toggle"
        class="md:hidden flex flex-col justify-center items-center w-11 h-11 gap-1.5 text-text-base hover:text-primary-dark transition-colors rounded-md hover:bg-bg-subtle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="block w-5 h-0.5 bg-current transition-all duration-200" id="menu-bar-1"></span>
        <span class="block w-5 h-0.5 bg-current transition-all duration-200" id="menu-bar-2"></span>
        <span class="block w-5 h-0.5 bg-current transition-all duration-200" id="menu-bar-3"></span>
      </button>
    </div>

  </div>

  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-border bg-bg-card"
  >
    <nav class="container-page py-4 flex flex-col gap-1" aria-label="Mobile navigation">
      {links.map((link) =>
        link.links?.length ? (
          <>
            <p class="px-3 pt-3 pb-1 text-xs font-semibold text-text-muted uppercase tracking-wider">
              {link.text}
            </p>
            {link.links.map((sub) => (
              <a
                href={sub.href}
                class="block pl-6 pr-3 py-2 text-text-base hover:text-primary-dark hover:bg-bg-subtle rounded-md transition-colors duration-150"
              >
                {sub.text}
              </a>
            ))}
          </>
        ) : (
          <a
            href={link.href}
            class={`block px-3 py-2 rounded-md font-medium transition-colors duration-150 hover:bg-bg-subtle ${link.href && currentPath === `/${trimSlash(link.href)}` ? 'text-primary-dark' : 'text-text-base hover:text-primary-dark-dark'}`}
          >
            {link.text}
          </a>
        )
      )}
      {actions.length > 0 && (
        <div class="pt-3 mt-2 border-t border-border flex flex-col gap-2">
          {actions.map((action) => (
            <Button href={action.href} variant={(action.variant as any) ?? 'primary'} class="w-full justify-center">
              {action.text}
            </Button>
          ))}
        </div>
      )}
    </nav>
  </div>
</header>

<script>
  function initHeader() {
    const header = document.getElementById('site-header');
    const headerInner = header?.querySelector('.container-nav') as HTMLElement | null;
    const logo = document.getElementById('site-logo') as HTMLImageElement | null;

    // Remove any previous scroll listener to avoid duplicates on navigation
    const prev = (window as any).__headerScrollHandler;
    if (prev) window.removeEventListener('scroll', prev);

    function onScroll() {
      const scrolled = window.scrollY > 40;
      const isMobile = window.innerWidth < 768;

      if (logo) {
        logo.classList.toggle('h-9',  !scrolled && isMobile);
        logo.classList.toggle('h-7',   scrolled && isMobile);
        logo.classList.toggle('md:h-12', !scrolled);
        logo.classList.toggle('md:h-9',   scrolled);
      }
      if (headerInner) {
        headerInner.classList.toggle('h-14',    !scrolled && isMobile);
        headerInner.classList.toggle('h-11',     scrolled && isMobile);
        headerInner.classList.toggle('md:h-20', !scrolled);
        headerInner.classList.toggle('md:h-14',  scrolled);
      }
    }

    (window as any).__headerScrollHandler = onScroll;
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const toggle = document.getElementById('menu-toggle');
    const menu   = document.getElementById('mobile-menu');
    const bar1   = document.getElementById('menu-bar-1');
    const bar2   = document.getElementById('menu-bar-2');
    const bar3   = document.getElementById('menu-bar-3');

    toggle?.addEventListener('click', () => {
      const isOpen = !menu?.classList.contains('hidden');

      if (isOpen) {
        menu?.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        bar1?.classList.remove('translate-y-2', 'rotate-45');
        bar2?.classList.remove('opacity-0');
        bar3?.classList.remove('-translate-y-2', '-rotate-45');
      } else {
        menu?.classList.remove('hidden');
        toggle.setAttribute('aria-expanded', 'true');
        bar1?.classList.add('translate-y-2', 'rotate-45');
        bar2?.classList.add('opacity-0');
        bar3?.classList.add('-translate-y-2', '-rotate-45');
      }
    });
  }

  document.addEventListener('astro:page-load', initHeader);
</script>
