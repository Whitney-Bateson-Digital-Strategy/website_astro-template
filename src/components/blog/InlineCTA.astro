---
export interface Props {
  heading?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  heading = 'Ready to take the next step?',
  description,
  ctaLabel = 'Get the free guide',
  ctaHref = '#',
} = Astro.props;
---

<aside class="my-10 rounded-2xl bg-accent px-8 py-8 not-prose">
  <div class="flex flex-col sm:flex-row sm:items-center gap-5 sm:gap-8">
    <div class="flex-1">
      <p class="text-lg font-bold text-white leading-snug mb-1">{heading}</p>
      {description && (
        <p class="text-white/80 text-sm leading-relaxed">{description}</p>
      )}
    </div>
    <div class="flex-shrink-0">
      <a
        href={ctaHref}
        class="inline-flex items-center justify-center px-6 py-3 rounded-[var(--radius-button)] bg-white text-accent font-semibold text-sm hover:bg-white/90 transition-colors duration-150 whitespace-nowrap"
      >
        {ctaLabel}
      </a>
    </div>
  </div>
</aside>
