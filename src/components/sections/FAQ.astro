---
import SectionWrapper from '~/components/common/SectionWrapper.astro';

export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  eyebrow?: string;
  heading: string;
  intro?: string;
  items: FAQItem[];
  background?: 'base' | 'subtle' | 'accent2-light';
}

const {
  eyebrow,
  heading,
  intro,
  items,
  background = 'base',
} = Astro.props;

const bgMap: Record<string, string> = {
  base:            'bg-bg-base',
  subtle:          'bg-bg-subtle',
  'accent2-light': 'bg-accent2-light',
};

// FAQPage schema for SEO + AI optimization
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<SectionWrapper class={bgMap[background]} bg={background}>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Header -->
  <div class="max-w-2xl mx-auto text-center mb-12">
    {eyebrow && (
      <p class="text-sm font-semibold uppercase tracking-widest text-primary-dark mb-3">{eyebrow}</p>
    )}
    <h2>{heading}</h2>
    {intro && <p class="mt-4 text-text-muted">{intro}</p>}
  </div>

  <!-- Accordion -->
  <div class="max-w-2xl mx-auto flex flex-col divide-y divide-border">
    {items.map((item) => (
      <details class="faq-item group py-5 first:pt-0 last:pb-0" name="faq">
        <summary class="flex items-center justify-between gap-4 cursor-pointer list-none select-none">
          <span class="font-semibold text-text-heading leading-snug pr-2">{item.question}</span>
          <span class="flex-shrink-0 w-6 h-6 rounded-full border border-border flex items-center justify-center transition-colors duration-200 group-open:bg-primary group-open:border-primary">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-3.5 h-3.5 text-text-muted transition-transform duration-300 group-open:rotate-45 group-open:text-white"
              fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
            </svg>
          </span>
        </summary>

        <div class="faq-body overflow-hidden">
          <p class="text-text-muted leading-relaxed pt-4 pb-1">{item.answer}</p>
        </div>
      </details>
    ))}
  </div>

</SectionWrapper>

<style>
  /* Smooth open/close via grid row height trick */
  .faq-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }
  details[open] .faq-body {
    grid-template-rows: 1fr;
  }
  .faq-body > * {
    overflow: hidden;
  }

  /* Remove default marker in all browsers */
  summary::-webkit-details-marker { display: none; }
</style>
