---
export interface StoryCard {
  heading: string;
  body: string;
}

export interface Props {
  name: string;
  title?: string;
  intro: string[];
  image: { src: string; alt: string; width?: number; height?: number };
  cards: StoryCard[];
  cta?: { text: string; href: string };
  background?: 'base' | 'subtle' | 'accent-light' | 'accent2-light';
}

const {
  name,
  title,
  intro,
  image,
  cards,
  cta,
  background = 'base',
} = Astro.props;

const bgMap: Record<string, string> = {
  base:            'bg-bg-base',
  subtle:          'bg-bg-subtle',
  'accent-light':  'bg-accent-light',
  'accent2-light': 'bg-accent2-light',
};
---

<section class={`section-py ${bgMap[background]}`} data-section-bg={background}>
  <div class="container-page">

    <!-- Split: image left, narrative right -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-stretch mb-16 md:mb-20">

      <!-- Image — absolutely fills the column, height driven by text -->
      <div class="relative min-h-[260px] overflow-hidden order-last md:order-first">
        <div class="absolute -bottom-4 -left-4 w-1/2 h-1/3 bg-accent/10 rounded-2xl -z-10"></div>
        <img
          src={image.src}
          alt={image.alt}
          class="absolute inset-0 w-full h-full rounded-2xl object-cover object-top drop-shadow-lg"
          width={image.width}
          height={image.height}
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Narrative -->
      <div>
        <h2 class="font-body text-sm font-semibold uppercase tracking-widest text-primary-dark mb-3">
          {name}
        </h2>
        {title && (
          <p class="text-text-muted font-medium mb-6">{title}</p>
        )}
        <div class="flex flex-col gap-5">
          {intro.map((p, i) => (
            i === 1
              ? (
                /* Pull quote styling on the second paragraph */
                <blockquote class="border-l-4 border-accent pl-5 italic text-[1.1rem] text-text-base font-medium leading-relaxed">
                  {p}
                </blockquote>
              )
              : (
                <p class="leading-relaxed text-text-muted">{p}</p>
              )
          ))}
        </div>

        {cta && (
          <a
            href={cta.href}
            class="group inline-flex items-center gap-2 mt-2 text-accent font-semibold hover:gap-3 transition-all duration-200"
          >
            {cta.text}
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        )}
      </div>

    </div>

    <!-- Story cards — stagger in on scroll -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {cards.map((card, i) => (
          <div
            data-story-card
            class={`opacity-0 bg-bg-card rounded-2xl p-8 flex flex-col gap-4 shadow-sm border-t-4 border-primary`}
            style={`transition-delay: ${i * 140}ms`}
          >
            <h3 class="text-accent text-[1.4rem] font-semibold leading-snug">{card.heading}</h3>
            <p class="leading-relaxed text-text-muted">{card.body}</p>
          </div>
      ))}
    </div>

  </div>
</section>

<style>
  [data-story-card] {
    transform: translateY(1.25rem);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  [data-story-card].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  function initStoryAnimations() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    document.querySelectorAll('[data-story-card]').forEach((el) => {
      observer.observe(el);
    });
  }

  document.addEventListener('astro:page-load', initStoryAnimations);
</script>
