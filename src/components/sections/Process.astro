---
import Button from '~/components/ui/Button.astro';
import SectionWrapper from '~/components/common/SectionWrapper.astro';

export interface Step {
  title: string;
  description: string;
}

export interface Props {
  eyebrow?: string;
  heading: string;
  intro?: string;
  steps: Step[];
  cta?: { text: string; href: string };
  background?: 'base' | 'subtle' | 'accent-light' | 'accent2-light' | 'primary' | 'accent' | 'accent2';
  spacing?: 'default' | 'tight' | 'loose';
}

const { eyebrow, heading, intro, steps, cta, background = 'accent2-light', spacing = 'default' } = Astro.props;

const bgMap: Record<string, string> = {
  base:            'bg-bg-base',
  subtle:          'bg-bg-subtle',
  'accent-light':  'bg-accent-light',
  'accent2-light': 'bg-accent2-light',
  primary:         'bg-primary',
  accent:          'bg-accent',
  accent2:         'bg-accent2',
};

const isDark = background === 'primary' || background === 'accent' || background === 'accent2';
---

<SectionWrapper class={bgMap[background]} bg={background} spacing={spacing}>

  <div class="max-w-2xl mx-auto">

    <!-- Header -->
    <div class="text-center mb-16 md:mb-20">
      {eyebrow && (
        <p class={`text-sm font-semibold uppercase tracking-widest mb-3 ${isDark ? 'text-white/60' : 'text-accent'}`}>
          {eyebrow}
        </p>
      )}
      <h2 class={isDark ? 'text-white' : ''}>{heading}</h2>
      {intro && (
        <p class={`mt-4 ${isDark ? 'text-white/75' : 'text-text-muted'}`}>{intro}</p>
      )}
    </div>

    <!-- Steps -->
    <div class="flex flex-col">
      {steps.map((step, i) => {
        const isLast = i === steps.length - 1;
        return (
          <div
            class="relative flex gap-8 md:gap-12"
            data-step
            style={`transition-delay: ${i * 160}ms`}
          >
            <!-- Left column: badge + connector line -->
            <div class="flex flex-col items-center flex-shrink-0 w-12">
              <div class={`w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0 z-10 ${isDark ? 'bg-white/20 text-white' : 'bg-primary text-white'}`}>
                {i + 1}
              </div>
              {!isLast && (
                <div class={`w-px flex-1 mt-3 min-h-[3rem] ${isDark ? 'bg-white/20' : 'bg-border'}`} />
              )}
            </div>

            <!-- Right column: content -->
            <div class={`${isLast ? 'pb-0' : 'pb-14'}`}>
              <h3 class={`mb-3 ${isDark ? 'text-white' : ''}`}>{step.title}</h3>
              <p class={`leading-relaxed ${isDark ? 'text-white/75' : 'text-text-muted'}`}>
                {step.description}
              </p>
            </div>

          </div>
        );
      })}
    </div>

    <!-- CTA -->
    {cta && (
      <div class="mt-14 md:mt-16 text-center">
        <Button href={cta.href} variant={isDark ? 'secondary' : 'primary'}>{cta.text}</Button>
      </div>
    )}

  </div>

</SectionWrapper>

<style>
  [data-step] {
    opacity: 0;
    transform: translateY(1.25rem);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  [data-step].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  function initProcessAnimations() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 }
    );

    document.querySelectorAll('[data-step]').forEach((el) => observer.observe(el));
  }

  document.addEventListener('astro:page-load', initProcessAnimations);
</script>
