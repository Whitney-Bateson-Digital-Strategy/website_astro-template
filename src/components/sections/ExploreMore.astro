---
import { Icon } from 'astro-icon/components';
import SectionWrapper from '~/components/common/SectionWrapper.astro';

export interface ExploreCard {
  image: { src: string; alt: string };
  label: string;
  heading: string;
  description: string;
  href: string;
  ctaLabel?: string;
}

export interface Props {
  eyebrow?: string;
  heading?: string;
  cards: ExploreCard[];
  background?: 'base' | 'subtle' | 'accent-light' | 'accent2-light';
}

const {
  eyebrow = 'Keep exploring',
  heading = "There's more to discover.",
  cards,
  background = 'subtle',
} = Astro.props;

const bgMap: Record<string, string> = {
  base:            'bg-bg-base',
  subtle:          'bg-bg-subtle',
  'accent-light':  'bg-accent-light',
  'accent2-light': 'bg-accent2-light',
};
---

<SectionWrapper class={bgMap[background]} bg={background}>

  <div class="text-center mb-10">
    {eyebrow && (
      <p class="text-sm font-semibold uppercase tracking-widest text-primary-dark mb-3">{eyebrow}</p>
    )}
    <h2>{heading}</h2>
  </div>

  <div class={`grid grid-cols-1 gap-6 ${cards.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3'}`}>
    {cards.map((card) => (
      <a
        href={card.href}
        class="group block rounded-2xl overflow-hidden bg-bg-card border border-border transition-shadow duration-300 hover:shadow-lg"
        aria-label={card.ctaLabel ?? `Explore: ${card.heading}`}
      >
        <!-- Image with subtle zoom on hover -->
        <div class="overflow-hidden aspect-[16/10]">
          <img
            src={card.image.src}
            alt={card.image.alt}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
        </div>

        <!-- Text content -->
        <div class="p-7">
          <p class="text-sm font-semibold uppercase tracking-widest text-primary-dark mb-2">{card.label}</p>
          <h3 class="text-[1.25rem] mb-3 leading-snug">{card.heading}</h3>
          <p class="text-text-muted leading-relaxed mb-5">{card.description}</p>
          <span class="inline-flex items-center gap-1.5 text-accent font-semibold text-sm group-hover:gap-2.5 transition-all duration-200">
            {card.ctaLabel ?? 'Explore'}
            <Icon name="tabler:arrow-right" class="w-4 h-4" aria-hidden="true" />
          </span>
        </div>

      </a>
    ))}
  </div>

</SectionWrapper>
