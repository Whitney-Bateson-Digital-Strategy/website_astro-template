---
import { Icon } from 'astro-icon/components';
import SectionWrapper from '~/components/common/SectionWrapper.astro';

export interface CredentialGroup {
  label: string;
  icon?: string;
  items: string[];
}

export interface Props {
  eyebrow?: string;
  heading?: string;
  groups: CredentialGroup[];
  background?: 'base' | 'subtle' | 'accent-light' | 'accent2-light' | 'secondary';
}

const {
  eyebrow = 'Background',
  heading = 'Training & credentials.',
  groups,
  background = 'base',
} = Astro.props;

const bgMap: Record<string, string> = {
  base:            'bg-bg-base',
  subtle:          'bg-bg-subtle',
  'accent-light':  'bg-accent-light',
  'accent2-light': 'bg-accent2-light',
  secondary:       'bg-secondary',
};
---

<SectionWrapper class={bgMap[background]} bg={background}>

  <div class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-10 md:gap-16 items-start">

    <!-- Left: heading -->
    <div class="md:sticky md:top-28">
      {eyebrow && (
        <p class="text-sm font-semibold uppercase tracking-widest text-primary-dark mb-3">{eyebrow}</p>
      )}
      <h2 class="text-[1.75rem] leading-snug">{heading}</h2>
    </div>

    <!-- Right: credential groups -->
    <div class="flex flex-col divide-y divide-border">
      {groups.map((group) => (
        <div class="flex gap-5 py-6 first:pt-0 last:pb-0">
          <!-- Icon -->
          <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-secondary flex items-center justify-center">
            <Icon
              name={group.icon ?? 'tabler:certificate'}
              class="w-5 h-5 text-primary-dark"
              aria-hidden="true"
            />
          </div>
          <!-- Content -->
          <div>
            <p class="font-semibold text-text-base mb-3">{group.label}</p>
            <ul class="flex flex-col gap-1.5">
              {group.items.map((item) => (
                <li class="text-text-muted leading-relaxed flex gap-2 items-start">
                  <span class="mt-[0.45rem] w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0" aria-hidden="true" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

  </div>

</SectionWrapper>
