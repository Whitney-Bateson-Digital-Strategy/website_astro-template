---
import SectionWrapper from '~/components/common/SectionWrapper.astro';

export interface Post {
  title: string;
  date: string; // ISO format: YYYY-MM-DD
  image: { src: string; alt: string };
  href: string;
  category?: string;
  excerpt?: string;
}

export interface Props {
  eyebrow?: string;
  heading: string;
  posts: Post[];
  viewAllLabel?: string;
  viewAllHref?: string;
  background?: 'base' | 'subtle' | 'accent2-light';
  spacing?: 'default' | 'tight' | 'loose';
}

const {
  eyebrow,
  heading,
  posts,
  viewAllLabel,
  viewAllHref,
  background = 'base',
  spacing = 'default',
} = Astro.props;

const bgMap: Record<string, string> = {
  base:            'bg-bg-base',
  subtle:          'bg-bg-subtle',
  'accent2-light': 'bg-accent2-light',
};
---

<SectionWrapper class={bgMap[background]} bg={background} spacing={spacing}>

  <!-- Header -->
  <div class="text-center mb-12 md:mb-14">
    {eyebrow && (
      <p class="text-sm font-semibold uppercase tracking-widest mb-3 text-accent">
        {eyebrow}
      </p>
    )}
    <h2>{heading}</h2>
  </div>

  <!-- Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {posts.map((post) => (
      <a
        href={post.href}
        class="group flex flex-col rounded-2xl overflow-hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
      >
        <!-- Photo -->
        <div class="overflow-hidden">
          <img
            src={post.image.src}
            alt={post.image.alt}
            class="w-full h-52 object-cover transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
        </div>

        <!-- Content -->
        <div class="bg-secondary rounded-b-2xl px-6 pt-6 pb-7 flex flex-col gap-3 flex-1">
          {post.category && (
            <p class="text-xs font-semibold uppercase tracking-widest text-primary-dark">
              {post.category}
            </p>
          )}
          <h3 class="text-text-heading leading-snug group-hover:text-primary-dark transition-colors duration-200">
            {post.title}
          </h3>
          {post.excerpt && (
            <p class="text-sm leading-relaxed text-text-muted flex-1">{post.excerpt}</p>
          )}
          <span class="inline-flex items-center gap-1 text-sm font-medium text-accent mt-1">
            Read more →
          </span>
        </div>
      </a>
    ))}
  </div>

  <!-- View all link -->
  {viewAllLabel && viewAllHref && (
    <div class="text-center mt-12">
      <a
        href={viewAllHref}
        class="inline-flex items-center gap-1.5 font-medium text-primary-dark hover:text-primary transition-colors duration-150"
      >
        {viewAllLabel} →
      </a>
    </div>
  )}

</SectionWrapper>
