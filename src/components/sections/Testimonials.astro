---
import SectionWrapper from '~/components/common/SectionWrapper.astro';

export interface Testimonial {
  quote: string;
  name: string;
  detail?: string;
  photo?: { src: string; alt: string };
}

export interface Props {
  eyebrow?: string;
  heading?: string;
  testimonials: Testimonial[];
  background?: 'base' | 'subtle' | 'accent-light' | 'accent2-light' | 'primary' | 'accent' | 'accent2';
}

const { eyebrow, heading, testimonials, background = 'subtle' } = Astro.props;

const bgMap: Record<string, string> = {
  base:            'bg-bg-base',
  subtle:          'bg-bg-subtle',
  'accent-light':  'bg-accent-light',
  'accent2-light': 'bg-accent2-light',
  primary:         'bg-primary',
  accent:          'bg-accent',
  accent2:         'bg-accent2',
};

const isDark = background === 'primary' || background === 'accent' || background === 'accent2';

const cardBg   = isDark ? 'bg-white/10'  : 'bg-bg-card';
const quoteMark = isDark ? 'text-white/40' : 'text-accent';
const quoteText = isDark ? 'text-white/85' : 'text-text-base';
const divider   = isDark ? 'border-white/20' : 'border-border';
const nameText  = isDark ? 'text-white' : 'text-text-base';
const detailText = isDark ? 'text-white/60' : 'text-text-muted';

// Subtle vertical stagger so cards don't sit in a flat row
const stagger = ['', 'md:mt-10', 'md:mt-5'];
---

<SectionWrapper class={`section-py ${bgMap[background]}`} bg={background}>

  {(eyebrow || heading) && (
    <div class="mb-12 md:mb-16">
      {eyebrow && (
        <p class={`text-sm font-semibold uppercase tracking-widest mb-3 ${isDark ? 'text-white/60' : 'text-accent'}`}>
          {eyebrow}
        </p>
      )}
      {heading && (
        <h2 class={isDark ? 'text-white' : ''}>{heading}</h2>
      )}
    </div>
  )}

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
    {testimonials.map((t, i) => (
      <div class={`flex flex-col rounded-2xl p-6 ${cardBg} ${stagger[i] ?? ''}`}>

        {/* Decorative quote mark */}
        <span
          class={`block text-5xl leading-none mb-2 select-none ${quoteMark}`}
          aria-hidden="true"
        >"</span>

        {/* Quote body */}
        <p class={`leading-relaxed flex-1 mb-5 italic ${quoteText}`}>
          {t.quote}
        </p>

        {/* Attribution */}
        <div class={`flex items-center gap-3 pt-5 border-t ${divider}`}>
          {t.photo && (
            <img
              src={t.photo.src}
              alt={t.photo.alt}
              class="w-11 h-11 rounded-full object-cover object-top flex-shrink-0"
              loading="lazy"
              decoding="async"
            />
          )}
          <div>
            <p class={`text-sm font-semibold uppercase tracking-widest ${nameText}`}>
              {t.name}
            </p>
            {t.detail && (
              <p class={`text-xs mt-0.5 ${detailText}`}>{t.detail}</p>
            )}
          </div>
        </div>

      </div>
    ))}
  </div>

</SectionWrapper>
