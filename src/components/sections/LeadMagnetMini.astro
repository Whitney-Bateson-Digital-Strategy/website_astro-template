---
export interface Props {
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  ctaHref = '#',
  ctaLabel = 'Get the free guide',
} = Astro.props;
---

<section id="lead-magnet" class="bg-primary-dark" data-section-bg="primary-dark">
  <div class="container-page py-10 md:py-12">
    <div class="flex flex-col md:flex-row md:items-center justify-center gap-6 md:gap-12">

      <!-- Text -->
      <div class="md:max-w-lg">
        <p class="text-sm font-semibold uppercase tracking-widest text-white/60 mb-1">Free guide</p>
        <h2 class="text-[1.35rem] leading-snug mb-2 text-white">5 Nutrition Myths That Are Keeping You Stuck</h2>
        <p class="text-white/75">Get the free guide and find out what to do instead.</p>
      </div>

      <!-- CTA -->
      <div class="flex-shrink-0">
        <a
          href={ctaHref}
          class="inline-flex items-center justify-center px-7 py-3 rounded-[var(--radius-button)] font-medium text-base whitespace-nowrap border-2 border-white text-white bg-transparent hover:bg-white/15 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2"
        >
          {ctaLabel}
        </a>
      </div>

    </div>
  </div>
</section>
