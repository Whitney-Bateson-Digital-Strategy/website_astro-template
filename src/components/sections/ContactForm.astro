---
import SectionWrapper from '~/components/common/SectionWrapper.astro';
import Button from '~/components/ui/Button.astro';
import headshot from '~/assets/images/Whitney Bateson Feb 2020-50 square small.jpeg';

export interface Props {
  background?: 'base' | 'subtle' | 'accent2-light';
}

const { background = 'base' } = Astro.props;

const bgMap: Record<string, string> = {
  base:            'bg-bg-base',
  subtle:          'bg-bg-subtle',
  'accent2-light': 'bg-accent2-light',
};
---

<SectionWrapper class={bgMap[background]} bg={background}>

  <div class="grid grid-cols-1 md:grid-cols-[5fr_7fr] gap-12 md:gap-16 items-start">

    <!-- Left: Contact info (shown after form on mobile) -->
    <div class="order-2 md:order-1">

      <!-- Headshot + intro -->
      <div class="flex items-center gap-4 mb-6">
        <img
          src={headshot.src}
          alt="Whitney Bateson, Registered Dietitian Nutritionist"
          class="w-16 h-16 rounded-full object-cover object-top flex-shrink-0 ring-2 ring-border"
          loading="lazy"
          decoding="async"
        />
        <div>
          <p class="font-semibold text-text-heading">Whitney Bateson, RDN</p>
          <p class="text-sm text-text-muted">Registered Dietitian Nutritionist</p>
        </div>
      </div>

      <h2 class="mb-2">Get in touch.</h2>
      <p class="text-text-muted mb-10">Have a question or want to learn more? Send a message and I'll get back to you within 1–2 business days.</p>

      <div class="flex flex-col gap-6">

        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-full bg-secondary flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
            </svg>
          </div>
          <div>
            <p class="font-semibold text-text-heading">Location</p>
            <p class="text-text-muted">Dallas–Fort Worth, TX</p>
            <p class="text-text-muted text-sm mt-0.5">In-person &amp; virtual appointments available</p>
          </div>
        </div>

        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-full bg-secondary flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
          </div>
          <div>
            <p class="font-semibold text-text-heading">Email</p>
            <a href="mailto:hello@whitneybateson.com" class="text-accent hover:underline">hello@whitneybateson.com</a>
          </div>
        </div>

        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-full bg-secondary flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
            </svg>
          </div>
          <div>
            <p class="font-semibold text-text-heading">Virtual clients</p>
            <p class="text-text-muted">Currently accepting clients in TX, VA, NY, IL, and GA</p>
          </div>
        </div>

        <div class="flex gap-4 items-start">
          <div class="w-10 h-10 rounded-full bg-secondary flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" stroke-linejoin="round" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
          </div>
          <div>
            <p class="font-semibold text-text-heading">Come say hi 👋</p>
            <a
              href="https://instagram.com/whitneybateson"
              target="_blank"
              rel="noopener noreferrer"
              class="text-accent hover:underline"
            >@whitneybateson</a>
            <p class="text-text-muted text-sm mt-0.5">Behind-the-scenes, nutrition tips, and the occasional food photo</p>
          </div>
        </div>

      </div>
    </div>

    <!-- Right: Form (shown first on mobile) -->
    <div class="order-1 md:order-2 bg-bg-card rounded-2xl p-8 md:p-10 border border-border">
      <form
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="flex flex-col gap-5"
      >
        <!-- Netlify hidden fields -->
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>Don't fill this out: <input name="bot-field" /></label>
        </p>

        <!-- Name row -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div class="flex flex-col gap-1.5">
            <label for="first-name" class="text-sm font-semibold text-text-heading">First name <span class="text-accent" aria-hidden="true">*</span></label>
            <input
              id="first-name"
              type="text"
              name="first-name"
              required
              autocomplete="given-name"
              class="rounded-md border border-border bg-bg-base px-4 py-2.5 text-text-base placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
              placeholder="Jane"
            />
          </div>
          <div class="flex flex-col gap-1.5">
            <label for="last-name" class="text-sm font-semibold text-text-heading">Last name <span class="text-accent" aria-hidden="true">*</span></label>
            <input
              id="last-name"
              type="text"
              name="last-name"
              required
              autocomplete="family-name"
              class="rounded-md border border-border bg-bg-base px-4 py-2.5 text-text-base placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
              placeholder="Smith"
            />
          </div>
        </div>

        <!-- Email -->
        <div class="flex flex-col gap-1.5">
          <label for="email" class="text-sm font-semibold text-text-heading">Email <span class="text-accent" aria-hidden="true">*</span></label>
          <input
            id="email"
            type="email"
            name="email"
            required
            autocomplete="email"
            class="rounded-md border border-border bg-bg-base px-4 py-2.5 text-text-base placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
            placeholder="jane@example.com"
          />
        </div>

        <!-- Phone -->
        <div class="flex flex-col gap-1.5">
          <label for="phone" class="text-sm font-semibold text-text-heading">
            Phone <span class="text-text-muted font-normal">(optional)</span>
          </label>
          <input
            id="phone"
            type="tel"
            name="phone"
            autocomplete="tel"
            class="rounded-md border border-border bg-bg-base px-4 py-2.5 text-text-base placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
            placeholder="(214) 555-0100"
          />
        </div>

        <!-- What brings you here -->
        <div class="flex flex-col gap-1.5">
          <label for="interest" class="text-sm font-semibold text-text-heading">What are you hoping to work on?</label>
          <select
            id="interest"
            name="interest"
            class="rounded-md border border-border bg-bg-base px-4 py-2.5 text-text-base focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition"
          >
            <option value="">Select one (optional)</option>
            <option value="general-nutrition">General nutrition &amp; healthy eating</option>
            <option value="weight">Weight management</option>
            <option value="gut-health">Gut health &amp; digestion</option>
            <option value="intuitive-eating">Intuitive eating &amp; food relationship</option>
            <option value="condition">Managing a health condition</option>
            <option value="other">Something else</option>
          </select>
        </div>

        <!-- Message -->
        <div class="flex flex-col gap-1.5">
          <label for="message" class="text-sm font-semibold text-text-heading">Message <span class="text-accent" aria-hidden="true">*</span></label>
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            class="rounded-md border border-border bg-bg-base px-4 py-2.5 text-text-base placeholder:text-text-muted focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition resize-y min-h-[8rem]"
            placeholder="Tell me a little about what's been going on and what you're looking for..."
          ></textarea>
        </div>

        <div class="pt-1">
          <Button type="submit" variant="primary" class="w-full justify-center">Send message</Button>
        </div>

      </form>
    </div>

  </div>

</SectionWrapper>
