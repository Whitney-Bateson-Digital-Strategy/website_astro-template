---
import SectionWrapper from '~/components/common/SectionWrapper.astro';

export interface Props {
  background?: 'base' | 'subtle' | 'accent2-light';
  minHeight?: string;
}

const { background = 'base', minHeight = '650px' } = Astro.props;

const bgMap: Record<string, string> = {
  base:            'bg-bg-base',
  subtle:          'bg-bg-subtle',
  'accent2-light': 'bg-accent2-light',
};
---

<SectionWrapper class={bgMap[background]} bg={background}>
  <div class="max-w-3xl mx-auto">
    <!--
      PASTE YOUR SCHEDULER EMBED CODE INSIDE THIS DIV.
      Supports Calendly, Acuity, TidyCal, or any iframe/script embed.

      Example (Calendly inline widget):
        <div
          class="calendly-inline-widget"
          data-url="https://calendly.com/your-link/30min"
          style="min-width:320px;height:700px;"
        ></div>
        <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>

      Remove this comment block once your embed code is in place.
    -->
    <slot>
      <!-- Placeholder shown until embed code is added -->
      <div
        class="flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-border text-text-muted gap-3"
        style={`min-height: ${minHeight}`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
        </svg>
        <p class="text-sm">Scheduler embed goes here</p>
      </div>
    </slot>
  </div>
</SectionWrapper>
