---
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';
import type { CallToAction as Props } from '~/types';

const {
  variant = 'secondary',
  target,
  text = Astro.slots.render('default'),
  icon = '',
  class: className = '',
  type,
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center font-medium leading-snug transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2';

const variants: Record<string, string> = {
  primary: twMerge(
    base,
    'bg-accent text-white px-6 py-3 rounded-md hover:bg-accent/85'
  ),
  secondary: twMerge(
    base,
    'border border-primary-dark text-primary-dark px-6 py-3 rounded-md hover:bg-primary-dark hover:text-white'
  ),
  outline: twMerge(
    base,
    'border border-white text-white px-6 py-3 rounded-md hover:bg-white hover:text-primary-dark'
  ),
  link: 'inline-flex items-center gap-1 text-primary-dark underline-offset-4 hover:underline hover:text-primary transition-colors duration-200',
  tertiary: 'inline-flex items-center gap-1 text-primary-dark underline-offset-4 hover:underline hover:text-primary transition-colors duration-200',
};

const classes = twMerge(variants[variant] ?? variants.secondary, className);
---

{
  type === 'button' || type === 'submit' || type === 'reset' ? (
    <button type={type} class={classes} {...rest}>
      <Fragment set:html={text} />
      {icon && <Icon name={icon} class="w-5 h-5 ml-1.5 -mr-1 inline-block" />}
    </button>
  ) : (
    <a
      class={classes}
      {...(target ? { target, rel: 'noopener noreferrer' } : {})}
      {...rest}
    >
      <Fragment set:html={text} />
      {icon && <Icon name={icon} class="w-5 h-5 ml-1.5 -mr-1 inline-block" />}
    </a>
  )
}
